{
  "mcpServers": {
    "rapid": { "type": "http", "url": "http://host.docker.internal:3100/mcp" },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "Context7-API-Key": "${CONTEXT7_API_KEY}" }
    },
    "tavily": {
      "type": "http",
      "url": "https://mcp.tavily.com/mcp",
      "headers": { "Authorization": "Bearer ${TAVILY_API_KEY}" }
    }
  }
}
