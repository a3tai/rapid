# RAPID Daemon
# Background session manager and service coordinator

FROM node:22-slim

WORKDIR /app

# Install git for worktree management
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package files and tsconfig
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY packages/daemon/package.json packages/daemon/
COPY packages/schema/package.json packages/schema/
COPY packages/core/package.json packages/core/
COPY packages/runtime/package.json packages/runtime/
COPY packages/rapid-eventbus/package.json packages/rapid-eventbus/

# Install dependencies
RUN pnpm install --frozen-lockfile --prod=false

# Copy source and build
COPY packages/schema packages/schema
COPY packages/core packages/core
COPY packages/runtime packages/runtime
COPY packages/rapid-eventbus packages/rapid-eventbus
COPY packages/daemon packages/daemon

# Build in dependency order
RUN pnpm --filter @a3t/rapid-schema build && \
    pnpm --filter @a3t/rapid-eventbus build && \
    pnpm --filter @a3t/rapid-core build && \
    pnpm --filter @a3t/rapid-runtime build && \
    pnpm --filter @a3t/rapid-daemon build

# Expose daemon API port
EXPOSE 3200

# Run daemon
ENV NODE_ENV=production
CMD ["node", "packages/daemon/dist/bin.js", "foreground", "--http-port", "3200"]
