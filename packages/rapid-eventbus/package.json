{
  "name": "@a3t/rapid-eventbus",
  "version": "0.2.0",
  "description": "Inter-agent event bus for RAPID multi-agent communication",
  "license": "MIT",
  "author": "A3T <hello@a3t.ai>",
  "homepage": "https://getrapid.dev",
  "repository": {
    "type": "git",
