{
  "name": "@a3t/rapid",
  "version": "0.1.4",
  "description": "CLI for RAPID - AI-assisted development with dev containers",
  "license": "MIT",
  "author": "Steve Rude <steve@rude.la>",
  "homepage": "https://getrapid.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/a3tai/rapid.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "rapid",
    "cli",
    "ai",
    "devcontainer",
    "claude",
    "opencode"
  ],
  "type": "module",
  "bin": {
    "rapid": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "echo 'No tests yet'",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@a3t/rapid-core": "workspace:*",
    "commander": "^14.0.0",
    "execa": "^9.6.1",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  }
}
