{
  "name": "@a3t/rapid",
  "version": "0.2.0",
  "description": "CLI for RAPID - AI-assisted development with dev containers",
  "license": "MIT",
  "author": "Steve Rude <steve@rude.la>",
  "homepage": "https://getrapid.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/a3tai/rapid.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "rapid",
    "cli",
    "ai",
    "devcontainer",
    "claude",
    "opencode"
  ],
  "type": "module",
  "bin": {
    "rapid": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@a3t/rapid-core": "workspace:*",
    "@a3t/rapid-daemon": "workspace:*",
    "@a3t/rapid-eventbus": "workspace:*",
    "@a3t/rapid-mcp": "workspace:*",
    "@a3t/rapid-runtime": "workspace:*",
    "@clack/prompts": "^0.11.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "execa": "^9.6.1",
    "giget": "^2.0.0",
    "ora": "^9.0.0",
    "prompts": "^2.4.2",
    "semver": "^7.7.3",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.7.1",
    "@types/update-notifier": "^6.0.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
