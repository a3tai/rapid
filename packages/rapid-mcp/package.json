{
  "name": "@a3t/rapid-mcp",
  "version": "0.2.0",
  "description": "MCP server exposing RAPID sandbox and governance capabilities to AI agents",
  "license": "MIT",
  "author": "Steve Rude <steve@rude.la>",
  "homepage": "https://getrapid.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/a3tai/rapid.git",
    "directory": "packages/rapid-mcp"
  },
  "keywords": [
    "rapid",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "sandbox",
    "governance"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rapid-mcp": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@a3t/rapid-core": "workspace:*",
    "@a3t/rapid-daemon": "workspace:*",
    "@a3t/rapid-eventbus": "workspace:*",
    "@a3t/rapid-runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "execa": "^9.6.1",
    "express": "^5.0.0",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^25.0.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
