---
/**
 * Custom Hero component for RAPID homepage
 * Dramatic animations with staggered reveals and floating elements
 */
import { Icon } from '@astrojs/starlight/components';

const { entry } = Astro.locals.starlightRoute;
const { data } = entry;
const { hero } = data;
const title = hero?.title || data.title || 'RAPID';
const tagline = hero?.tagline || 'AI-assisted development with dev containers.';
const actions = hero?.actions || [];

const rapidMethods = [
  {
    letter: 'R',
    name: 'Research',
    desc: 'Explore codebase structure and patterns.',
    icon: 'open-book' as const,
  },
  {
    letter: 'A',
    name: 'Augment',
    desc: 'Connect APIs, MCP servers, docs.',
    icon: 'puzzle' as const,
  },
  {
    letter: 'P',
    name: 'Plan',
    desc: 'Break down tasks and set criteria.',
    icon: 'document' as const,
  },
  {
    letter: 'I',
    name: 'Integrate',
    desc: 'Configure containers and secrets.',
    icon: 'laptop' as const,
  },
  { letter: 'D', name: 'Develop', desc: 'Generate, test, iterate, ship.', icon: 'pencil' as const },
];
---

<div class="hero">
  <!-- Floating geometric decorations -->
  <div class="floating-elements" aria-hidden="true">
    <div class="float float-1"></div>
    <div class="float float-2"></div>
    <div class="float float-3"></div>
    <div class="float float-4"></div>
    <div class="float float-5"></div>
  </div>

  <!-- Animated gradient orbs -->
  <div class="orb orb-1" aria-hidden="true"></div>
  <div class="orb orb-2" aria-hidden="true"></div>

  <!-- SVG gradient definition for icons -->
  <svg width="0" height="0" style="position: absolute;">
    <defs>
      <linearGradient id="icon-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color: #ffffff"></stop>
        <stop offset="100%" style="stop-color: #a5b4fc"></stop>
      </linearGradient>
    </defs>
  </svg>

  <div class="hero-content">
    <h1 class="hero-title anim-reveal">
      <span class="title-chars">{title.split('').map((char: string, i: number) => (
          <span class="char" style={`--char-index: ${i}`}>{char}</span>
        ))}</span><span class="cursor">_</span>
    </h1>

    <p class="hero-tagline anim-fade-up" style="--delay: 0.4s" set:html={tagline} />

    {
      actions.length > 0 && (
        <div class="hero-actions anim-fade-up" style="--delay: 0.6s">
          {actions.map((action: any, i: number) => (
            <a
              href={action.link}
              class={`btn ${action.variant === 'primary' ? 'btn-primary' : 'btn-secondary'}`}
              style={`--btn-delay: ${0.7 + i * 0.1}s`}
            >
              {action.text}
            </a>
          ))}
        </div>
      )
    }

    <div class="hero-install anim-fade-up" style="--delay: 0.8s">
      <div class="install-box">
        <span class="install-prompt">$</span>
        <code class="install-command">npm install -g @a3t/rapid</code>
        <button
          class="copy-btn"
          data-copy="npm install -g @a3t/rapid"
          aria-label="Copy to clipboard"
        >
          <svg
            class="copy-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg
            class="check-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <div class="rapid-methods">
      {
        rapidMethods.map((method, i) => (
          <div class="method-card anim-card" style={`--card-index: ${i}`}>
            <div class="method-icon">
              <Icon name={method.icon} />
            </div>
            <div class="method-name">{method.name}</div>
            <div class="method-desc">{method.desc}</div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="hero-glow"></div>
</div>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        await navigator.clipboard.writeText(text);
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 2000);
      }
    });
  });
</script>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     Base Hero Layout
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem 3rem;
    text-align: center;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-top: -1rem;
    min-height: 85vh;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 64rem;
    width: 100%;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     Floating Geometric Elements
     ═══════════════════════════════════════════════════════════════════════════ */
  .floating-elements {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  .float {
    position: absolute;
    border-radius: 2px;
    opacity: 0.15;
    animation: float-drift 20s ease-in-out infinite;
  }

  .float-1 {
    width: 3px;
    height: 60px;
    background: linear-gradient(180deg, hsl(var(--brand)), transparent);
    top: 15%;
    left: 10%;
    animation-delay: 0s;
    transform: rotate(15deg);
  }

  .float-2 {
    width: 40px;
    height: 40px;
    border: 1px solid hsl(var(--brand) / 0.5);
    top: 25%;
    right: 15%;
    animation-delay: -4s;
    animation-duration: 25s;
  }

  .float-3 {
    width: 2px;
    height: 80px;
    background: linear-gradient(180deg, transparent, hsl(var(--brand)), transparent);
    bottom: 30%;
    left: 20%;
    animation-delay: -8s;
    transform: rotate(-20deg);
  }

  .float-4 {
    width: 6px;
    height: 6px;
    background: hsl(var(--brand));
    border-radius: 50%;
    top: 40%;
    right: 25%;
    animation-delay: -12s;
    animation-duration: 15s;
  }

  .float-5 {
    width: 50px;
    height: 1px;
    background: linear-gradient(90deg, transparent, hsl(var(--brand) / 0.6), transparent);
    bottom: 25%;
    right: 10%;
    animation-delay: -6s;
    animation-duration: 22s;
  }

  @keyframes float-drift {
    0%, 100% {
      transform: translate(0, 0) rotate(var(--rotation, 0deg));
      opacity: 0.1;
    }
    25% {
      transform: translate(10px, -20px) rotate(calc(var(--rotation, 0deg) + 5deg));
      opacity: 0.2;
    }
    50% {
      transform: translate(-5px, -10px) rotate(calc(var(--rotation, 0deg) - 3deg));
      opacity: 0.15;
    }
    75% {
      transform: translate(15px, 10px) rotate(calc(var(--rotation, 0deg) + 8deg));
      opacity: 0.18;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     Animated Gradient Orbs
     ═══════════════════════════════════════════════════════════════════════════ */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 2;
  }

  .orb-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, hsl(var(--brand) / 0.25) 0%, transparent 70%);
    top: -10%;
    left: 50%;
    transform: translateX(-50%);
    animation: orb-pulse 8s ease-in-out infinite;
  }

  .orb-2 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, hsl(280 70% 50% / 0.15) 0%, transparent 70%);
    bottom: 10%;
    right: -5%;
    animation: orb-pulse 10s ease-in-out infinite reverse;
    animation-delay: -3s;
  }

  @keyframes orb-pulse {
    0%, 100% {
      transform: translateX(-50%) scale(1);
      opacity: 0.6;
    }
    50% {
      transform: translateX(-50%) scale(1.15);
      opacity: 0.9;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     Title with Character Animation
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-title {
    font-family: var(--font-mono);
    font-size: clamp(3rem, 12vw, 5.5rem);
    font-weight: 400;
    letter-spacing: 0.2em;
    color: hsl(var(--foreground));
    margin: 0 0 1.5rem;
    line-height: 1;
  }

  .title-chars {
    display: inline-block;
  }

  .char {
    display: inline-block;
    background: linear-gradient(135deg, hsl(var(--foreground)) 0%, hsl(var(--brand)) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: char-reveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--char-index) * 0.08s);
    opacity: 0;
    transform: translateY(30px) rotateX(-40deg);
    transform-origin: center bottom;
  }

  @keyframes char-reveal {
    0% {
      opacity: 0;
      transform: translateY(30px) rotateX(-40deg);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) rotateX(0);
      filter: blur(0);
    }
  }

  .cursor {
    display: inline-block;
    color: hsl(var(--brand));
    -webkit-text-fill-color: hsl(var(--brand));
    animation: cursor-blink 1s step-end infinite;
    animation-delay: 0.5s;
    opacity: 0;
  }

  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     Staggered Fade-Up Animations
     ═══════════════════════════════════════════════════════════════════════════ */
  .anim-fade-up {
    opacity: 0;
    transform: translateY(20px);
    animation: fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--delay, 0s);
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     Tagline
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-tagline {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    color: hsl(var(--muted-foreground));
    margin: 0 0 2.5rem;
    line-height: 1.6;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     Action Buttons
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .btn {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    padding: 0.875rem 1.75rem;
    border-radius: 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn-primary {
    background: linear-gradient(135deg, hsl(250 85% 60%) 0%, hsl(240 85% 55%) 100%);
    color: white;
    font-weight: 600;
    border: 1px solid hsl(0 0% 100% / 0.15);
    box-shadow:
      0 2px 4px hsl(0 0% 0% / 0.2),
      0 8px 24px hsl(var(--brand) / 0.3),
      inset 0 1px 0 hsl(0 0% 100% / 0.1);
  }

  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, hsl(0 0% 100% / 0.15) 0%, transparent 50%);
    pointer-events: none;
  }

  .btn-primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 0%, hsl(0 0% 100% / 0.1) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .btn-primary:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow:
      0 8px 16px hsl(0 0% 0% / 0.25),
      0 16px 40px hsl(var(--brand) / 0.4),
      inset 0 1px 0 hsl(0 0% 100% / 0.15);
  }

  .btn-primary:hover::after {
    opacity: 1;
  }

  .btn-primary:active {
    transform: translateY(-1px) scale(1);
  }

  .btn-secondary {
    background: hsl(0 0% 100% / 0.04);
    color: hsl(var(--foreground) / 0.9);
    border: 1px solid hsl(0 0% 100% / 0.1);
    backdrop-filter: blur(12px);
  }

  .btn-secondary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, hsl(0 0% 100% / 0.05) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .btn-secondary:hover {
    background: hsl(0 0% 100% / 0.08);
    border-color: hsl(0 0% 100% / 0.15);
    color: hsl(var(--foreground));
    transform: translateY(-3px);
    box-shadow: 0 8px 24px hsl(0 0% 0% / 0.2);
  }

  .btn-secondary:hover::before {
    opacity: 1;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     Install Command Box
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-install {
    display: flex;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .install-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: hsl(var(--card) / 0.6);
    border: 1px solid hsl(var(--border) / 0.5);
    border-radius: 12px;
    padding: 0.875rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    backdrop-filter: blur(12px);
    transition: all 0.3s ease;
  }

  .install-box:hover {
    border-color: hsl(var(--border));
    background: hsl(var(--card) / 0.8);
    box-shadow: 0 4px 20px hsl(0 0% 0% / 0.2);
  }

  .install-prompt {
    color: hsl(var(--brand));
    user-select: none;
    font-weight: 500;
  }

  .install-command {
    color: hsl(var(--foreground));
  }

  .copy-btn {
    background: hsl(var(--secondary) / 0.5);
    border: 1px solid hsl(var(--border) / 0.5);
    border-radius: 6px;
    padding: 0.375rem;
    cursor: pointer;
    color: hsl(var(--muted-foreground));
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .copy-btn:hover {
    color: hsl(var(--brand));
    background: hsl(var(--brand) / 0.1);
    border-color: hsl(var(--brand) / 0.3);
  }

  .copy-btn .check-icon {
    display: none;
    color: hsl(142 76% 50%);
  }

  .copy-btn.copied .copy-icon { display: none; }
  .copy-btn.copied .check-icon { display: block; }

  /* ═══════════════════════════════════════════════════════════════════════════
     RAPID Method Cards with Cascade Animation
     ═══════════════════════════════════════════════════════════════════════════ */
  .rapid-methods {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    width: 100%;
  }

  .method-card {
    background: hsl(var(--card) / 0.4);
    border: 1px solid hsl(var(--border) / 0.4);
    border-radius: 16px;
    padding: 1.5rem 1rem;
    text-align: center;
    backdrop-filter: blur(8px);
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
  }

  .method-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, hsl(var(--brand) / 0.1) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .method-card:hover {
    background: hsl(var(--card) / 0.7);
    border-color: hsl(var(--brand) / 0.4);
    transform: translateY(-8px) scale(1.02);
    box-shadow:
      0 12px 32px hsl(0 0% 0% / 0.25),
      0 0 0 1px hsl(var(--brand) / 0.2);
  }

  .method-card:hover::before {
    opacity: 1;
  }

  /* Card cascade animation */
  .anim-card {
    opacity: 0;
    transform: translateY(40px) scale(0.95);
    animation: card-cascade 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(1s + var(--card-index) * 0.1s);
  }

  @keyframes card-cascade {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .method-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, hsl(var(--brand) / 0.25) 0%, hsl(var(--brand) / 0.1) 100%);
    border: 1px solid hsl(var(--brand) / 0.35);
    border-radius: 14px;
    padding: 0.875rem;
    margin-bottom: 0.75rem;
    transition: all 0.3s ease;
  }

  .method-card:hover .method-icon {
    transform: scale(1.1);
    box-shadow: 0 0 20px hsl(var(--brand) / 0.4);
  }

  .method-icon :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
    fill: url(#icon-gradient) !important;
  }

  .method-name {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin-bottom: 0.5rem;
  }

  .method-desc {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     Background Glow
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 100% 60% at 50% 10%,
      hsl(var(--brand) / 0.12),
      transparent 60%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     Responsive Design
     ═══════════════════════════════════════════════════════════════════════════ */
  @media (max-width: 960px) {
    .hero {
      min-height: auto;
      padding: 3rem 1.5rem 2.5rem;
    }

    .rapid-methods {
      grid-template-columns: repeat(3, 1fr);
    }

    .float-2, .float-4 {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2.5rem 1rem 2rem;
    }

    .hero-title {
      letter-spacing: 0.12em;
    }

    .hero-tagline {
      font-size: 1.0625rem;
    }

    .install-box {
      flex-wrap: wrap;
      justify-content: center;
    }

    .rapid-methods {
      grid-template-columns: repeat(2, 1fr);
    }

    .method-card:last-child {
      grid-column: span 2;
    }

    .floating-elements {
      display: none;
    }

    .orb-1 {
      width: 300px;
      height: 300px;
    }

    .orb-2 {
      display: none;
    }
  }

  /* Reduce motion for accessibility */
  @media (prefers-reduced-motion: reduce) {
    .char,
    .anim-fade-up,
    .anim-card {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .float,
    .orb {
      animation: none;
    }

    .cursor {
      animation: blink 1s step-end infinite;
    }
  }
</style>
