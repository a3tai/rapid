---
/**
 * Custom Footer component with A3T attribution
 */
const year = new Date().getFullYear();
---

<footer class="rapid-footer">
  <div class="footer-content">
    <div class="footer-brand">
      <span class="footer-logo">RAPID</span>
      <span class="footer-attribution">
        An open source project by <a href="https://a3t.ai" target="_blank" rel="noopener">A3T</a>
      </span>
    </div>
    
    <div class="footer-links">
      <a href="https://github.com/a3tai/rapid" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.npmjs.com/package/@a3t/rapid-cli" target="_blank" rel="noopener">npm</a>
      <a href="/getting-started/introduction/">Docs</a>
    </div>
    
    <div class="footer-legal">
      <span>MIT License</span>
      <span class="separator">·</span>
      <span>&copy; {year} A3T</span>
    </div>
  </div>
</footer>

<style>
  .rapid-footer {
    border-top: 1px solid hsl(var(--border) / 0.5);
    background: hsl(var(--background));
    padding: 2rem 1.5rem;
    margin-top: auto;
  }
  
  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  
  .footer-logo {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: hsl(var(--foreground));
  }
  
  .footer-attribution {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
  }
  
  .footer-attribution a {
    color: hsl(var(--brand));
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }
  
  .footer-attribution a:hover {
    opacity: 0.8;
  }
  
  .footer-links {
    display: flex;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  
  .footer-links a {
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .footer-links a:hover {
    color: hsl(var(--brand));
  }
  
  .footer-legal {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
    display: flex;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.7;
  }
  
  .separator {
    opacity: 0.5;
  }
  
  @media (min-width: 768px) {
    .footer-content {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
    
    .footer-brand {
      align-items: flex-start;
    }
  }
</style>
