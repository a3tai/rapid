{
  "name": "rapid",
  "version": "0.0.0",
  "private": true,
  "description": "AI-assisted development with dev containers",
  "repository": {
    "type": "git",
    "url": "https://github.com/a3tai/rapid.git"
  },
  "homepage": "https://getrapid.dev",
  "author": "A3T <hello@a3t.ai>",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "docs:dev": "pnpm --filter @a3t/rapid-docs dev",
    "docs:build": "pnpm --filter @a3t/rapid-docs build",
    "cli:build": "pnpm --filter @a3t/rapid-cli build",
    "cli:dev": "pnpm --filter @a3t/rapid-cli dev",
    "rapid": "pnpm --filter @a3t/rapid-cli rapid"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.3.0"
  }
}
