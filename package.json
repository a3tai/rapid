{
  "name": "rapid",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted development with dev containers",
  "repository": {
    "type": "git",
    "url": "https://github.com/a3tai/rapid.git"
  },
  "homepage": "https://getrapid.dev",
  "author": "Steve Rude <steve@rude.la>",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "docs:dev": "pnpm --filter @a3t/rapid-docs dev",
    "docs:build": "pnpm --filter @a3t/rapid-docs build",
    "docs:deploy": "pnpm --filter @a3t/rapid-docs pages:deploy",
    "desktop:dev": "pnpm --filter rapid-desktop-frontend dev",
    "desktop:build": "pnpm --filter rapid-desktop-frontend build",
    "desktop:wails": "cd apps/rapid-desktop && (command -v wails >/dev/null 2>&1 || PATH=\"$HOME/go/bin:$PATH\" command -v wails >/dev/null 2>&1 || { echo 'Installing Wails v2 CLI...'; go install github.com/wailsapp/wails/v2/cmd/wails@latest; }) && PATH=\"$HOME/go/bin:$PATH\" wails dev",
    "desktop:wails:build": "cd apps/rapid-desktop && PATH=\"$HOME/go/bin:$PATH\" wails build",
    "desktop:install-wails": "go install github.com/wailsapp/wails/v2/cmd/wails@latest && echo 'Wails v2 installed. Add ~/go/bin to your PATH or run: export PATH=\"$HOME/go/bin:$PATH\"'",
    "cli:build": "turbo build --filter=@a3t/rapid-core --filter=@a3t/rapid",
    "cli:dev": "turbo dev --filter=@a3t/rapid-core --filter=@a3t/rapid",
    "cli:run": "node packages/cli/dist/bin.js",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rollup/rollup-linux-arm64-gnu": "^4.55.2",
    "@types/node": "^25.0.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.17",
    "wrangler": "^4.59.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "h3": ">=1.15.5",
      "undici": ">=7.18.2"
    },
    "onlyBuiltDependencies": ["esbuild", "sharp", "workerd"]
  }
}
