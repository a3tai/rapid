{
  "name": "rapid",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "AI-assisted development with dev containers",
  "repository": {
    "type": "git",
    "url": "https://github.com/a3tai/rapid.git"
  },
  "homepage": "https://getrapid.dev",
  "author": "Steve Rude <steve@rude.la>",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "docs:dev": "pnpm --filter @a3t/rapid-docs dev",
    "docs:build": "pnpm --filter @a3t/rapid-docs build",
    "docs:deploy": "pnpm --filter @a3t/rapid-docs pages:deploy",
    "cli:build": "turbo build --filter=@a3t/rapid-core --filter=@a3t/rapid-cli",
    "cli:dev": "turbo dev --filter=@a3t/rapid-core --filter=@a3t/rapid-cli",
    "cli:run": "node packages/cli/dist/bin.js",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-unicorn": "^57.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.0",
    "prettier-plugin-astro": "^0.14.0",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5",
    "wrangler": "^4.59.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,yaml,yml}": [
      "prettier --write"
    ]
  }
}
