# RAPID Environment Variables
# API keys stored in 1Password: A3T > RAPID

# Load secrets from 1Password when running locally with direnv
if command -v op &> /dev/null; then
  export TAVILY_API_KEY="$(op read 'op://A3T/RAPID/TAVILY_API_KEY')"
  export CONTEXT7_API_KEY="$(op read 'op://A3T/RAPID/CONTEXT7_API_KEY')"
else
  echo "Warning: 1Password CLI (op) not found. API keys will not be loaded."
fi
