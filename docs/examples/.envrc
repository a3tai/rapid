# .envrc - RAPID Project Secrets
# Generated by: rapid secrets generate
# 
# This file is SAFE TO COMMIT - it contains only references to secrets,
# not the actual secret values. Secrets are fetched at runtime from 1Password.
#
# Prerequisites:
#   1. Install 1Password CLI: brew install 1password-cli
#   2. Install direnv: brew install direnv
#   3. Sign in: eval $(op signin)
#   4. Allow this file: direnv allow

# =============================================================================
# SECRETS (fetched from 1Password at runtime)
# =============================================================================

# AI Provider API Keys
export ANTHROPIC_API_KEY=$(op read "op://Development/Anthropic/api-key")
export OPENAI_API_KEY=$(op read "op://Development/OpenAI/api-key")

# GitHub Access
export GITHUB_TOKEN=$(op read "op://Development/GitHub/pat")

# Database (if needed)
export DATABASE_URL=$(op read "op://Development/Database/connection-string")

# =============================================================================
# LOCAL OVERRIDES (optional, gitignored)
# =============================================================================
# Create .envrc.local for personal overrides or additional non-secret config
# Example .envrc.local:
#   export LOG_LEVEL=debug
#   export ANTHROPIC_API_KEY=$(op read "op://Personal/Anthropic/api-key")

[[ -f .envrc.local ]] && source_env .envrc.local

# =============================================================================
# NON-SENSITIVE CONFIG (optional)
# =============================================================================
# You can also load non-sensitive config from .env.local (but never secrets!)

[[ -f .env.local ]] && source_env .env.local
