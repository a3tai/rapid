{
  "name": "RAPID Go",
  "image": "mcr.microsoft.com/devcontainers/go:1.23",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-contrib/features/direnv:1": {},
    "ghcr.io/devcontainers-contrib/features/starship:1": {},
    "ghcr.io/devcontainers-contrib/features/1password-cli:1": {},
    "ghcr.io/devcontainers-contrib/features/jq:1": {}
  },
  "containerEnv": {
    "OP_SERVICE_ACCOUNT_TOKEN": "${localEnv:OP_SERVICE_ACCOUNT_TOKEN}",
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "mounts": [
    {
      "source": "${localEnv:SSH_AUTH_SOCK}",
      "target": "/ssh-agent",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "zxh404.vscode-proto3", "tamasfe.even-better-toml"],
      "settings": {
        "go.useLanguageServer": true,
        "go.lintTool": "golangci-lint",
        "go.lintFlags": ["--fast"],
        "[go]": {
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  },
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && curl -fsSL https://opencode.ai/install | bash && go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest && go install github.com/air-verse/air@latest",
  "postStartCommand": "direnv allow 2>/dev/null || true",
  "remoteUser": "vscode"
}
