# .envrc - RAPID Infrastructure Project
# Safe to commit - contains only references, not actual secrets

# =============================================================================
# AI PROVIDER KEYS
# =============================================================================
export ANTHROPIC_API_KEY=$(op read "op://Development/Anthropic/api-key")

# =============================================================================
# AWS CREDENTIALS
# =============================================================================
export AWS_ACCESS_KEY_ID=$(op read "op://Development/AWS/access-key-id")
export AWS_SECRET_ACCESS_KEY=$(op read "op://Development/AWS/secret-access-key")
export AWS_REGION=$(op read "op://Development/AWS/region")

# =============================================================================
# AZURE CREDENTIALS (if using Azure)
# =============================================================================
# export AZURE_SUBSCRIPTION_ID=$(op read "op://Development/Azure/subscription-id")
# export AZURE_TENANT_ID=$(op read "op://Development/Azure/tenant-id")
# export AZURE_CLIENT_ID=$(op read "op://Development/Azure/client-id")
# export AZURE_CLIENT_SECRET=$(op read "op://Development/Azure/client-secret")

# =============================================================================
# GCP CREDENTIALS (if using GCP)
# =============================================================================
# export GOOGLE_PROJECT=$(op read "op://Development/GCP/project-id")
# export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/gcloud/application_default_credentials.json"

# =============================================================================
# KUBERNETES
# =============================================================================
# export KUBECONFIG="$HOME/.kube/config"

# =============================================================================
# TERRAFORM
# =============================================================================
export TF_VAR_environment="dev"
# export TF_CLI_ARGS_plan="-parallelism=30"

# =============================================================================
# LOCAL OVERRIDES
# =============================================================================
[[ -f .envrc.local ]] && source_env .envrc.local
